# Public base URL of this site (set in Vercel; defaults to the demo hostname in code)
NEXT_PUBLIC_SITE_URL=

# seo-engine Article API (server-side only, never prefix with NEXT_PUBLIC_).
# Leave unset until the blog is wired; the site renders an empty blog without them.
SEOENGINE_API_URL=
SEOENGINE_API_KEY=
SEOENGINE_SITE=
